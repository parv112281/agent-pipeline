#!/usr/bin/env bash
# systemd does not source shell startup files. Resolve this pipeline's Node via nvm.
set -eo pipefail
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  echo "Pipeline runtime: nvm.sh is missing from $NVM_DIR" >&2
  exit 78
fi
source "$NVM_DIR/nvm.sh" --no-use
if ! nvm use --silent agent-pipeline >/dev/null; then
  echo "Pipeline runtime: install Node 24 and set 'nvm alias agent-pipeline 24'." >&2
  exit 78
fi
if [[ "$(node -p 'process.versions.node.split(".")[0]')" != 24 ]]; then
  echo "Pipeline runtime: nvm alias agent-pipeline must select Node 24." >&2
  exit 78
fi
exec node "$@"
