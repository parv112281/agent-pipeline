      {
        "parameters": {
          "jsCode": "// Turn the tick result into one item per notification.\n// Anything unexpected (host-tools down, non-zero exit, timeout, output that is not the agreed JSON)\n// gives no items: nothing is sent, nothing is acknowledged, and the next tick starts fresh.\nconst r = $input.first()?.json ?? {};\nif (r.exit_code !== 0 || r.timed_out || typeof r.output !== 'string') return [];\nlet parsed;\ntry {\n  parsed = JSON.parse(r.output);\n} catch (e) {\n  return [];\n}\nconst list = Array.isArray(parsed?.notifications) ? parsed.notifications : [];\nreturn list\n  .filter(n => n && typeof n.id === 'string' && n.id && typeof n.text === 'string' && n.text.trim())\n  .slice(0, 5)\n  .map(n => ({ json: { id: n.id, text: n.text } }));"
        },
