{
  "flesh-out": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "opus",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "cwd": "{repo}",
    "pr": true,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "docs"
    }
  },
  "specify": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "opus",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "cwd": "{repo}",
    "pr": true,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "docs"
    }
  },
  "onboard": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "opus",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "cwd": "{repo}",
    "pr": true,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "docs"
    }
  },
  "plan": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "opus",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "--disallowedTools",
      "Edit,Write,NotebookEdit"
    ],
    "cwd": "{repo}",
    "pr": false,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "plan"
    }
  },
  "build": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "sonnet",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(node --test:*)",
      "WebFetch",
      "WebSearch"
    ],
    "cwd": "{repo}",
    "pr": true,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "node"
    }
  },
  "build-python": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "sonnet",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "WebFetch",
      "WebSearch"
    ],
    "cwd": "{repo}",
    "pr": true,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "python"
    }
  },
  "build-sandbox": {
    "command": "claude",
    "args": [
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--model",
      "sonnet",
      "--permission-mode",
      "acceptEdits",
      "--settings",
      "__HOME__/agent-pipeline/board/agent/sandbox-settings.json",
      "--allowedTools",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "cwd": "{repo}",
    "pr": true,
    "fallback": {
      "provider": "codex",
      "command": "__HOME__/.local/bin/codex",
      "profile": "sandbox",
      "settings": "__HOME__/agent-pipeline/board/agent/sandbox-settings.json"
    }
  }
}
